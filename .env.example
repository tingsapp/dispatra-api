DATABASE_URL=postgresql+psycopg://dispatra_runtime:CHANGE_ME@localhost:5432/dispatra
MIGRATION_DATABASE_URL=postgresql+psycopg://dispatra_owner:CHANGE_ME@localhost:5432/dispatra
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local HTTP development only. Use true behind HTTPS in deployment.
COOKIE_SECURE=false
# Explicit local demonstration mode: no external routing calls or charges.
# Production: use google and a separate server-restricted Routes API key.
ROUTING_PROVIDER=demo
GOOGLE_ROUTES_API_KEY=
# Web address used for links in Shipper order-update emails, e.g. https://app.example.com
PUBLIC_WEB_URL=
# Email worker (python -m app.operations.email_worker). Keep the real app password only in private .env.
# Platform fallback for companies without a connected mailbox; each company's own mailbox sends its mail.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=YOUR_SMTP_USERNAME
SMTP_FROM=YOUR_SENDER_ADDRESS
SMTP_APP_PASSWORD=YOUR_SMTP_APP_PASSWORD
# Order agent (email intake). Run `python -m app.intake.worker` alongside the API.
# Encrypts company mailbox passwords; generate once with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Losing or changing it means every company must re-enter its mailbox password.
MAILBOX_ENCRYPTION_KEY=
OPENAI_API_KEY=
ORDER_AGENT_MODEL=gpt-5.5
ORDER_AGENT_REASONING=low
# Dispatch agent (defaults: ORDER_AGENT_MODEL, low reasoning, 12-hour AUTO horizon)
DISPATCH_AGENT_MODEL=
DISPATCH_AGENT_REASONING=low
DISPATCH_AGENT_HORIZON_HOURS=12
# Optional; defaults to GOOGLE_ROUTES_API_KEY. Needs the Geocoding API enabled.
GOOGLE_GEOCODING_API_KEY=
