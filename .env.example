DATABASE_URL=postgresql+psycopg://dispatra_runtime:CHANGE_ME@localhost:5432/dispatra
MIGRATION_DATABASE_URL=postgresql+psycopg://dispatra_owner:CHANGE_ME@localhost:5432/dispatra
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Local HTTP development only. Use true behind HTTPS in deployment.
COOKIE_SECURE=false
# Explicit local demonstration mode: no external routing calls or charges.
# Production: use google and a separate server-restricted Routes API key.
ROUTING_PROVIDER=demo
GOOGLE_ROUTES_API_KEY=
# Quote/invoice email worker. Keep the real app password only in private .env.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=YOUR_SMTP_USERNAME
SMTP_FROM=YOUR_SENDER_ADDRESS
SMTP_APP_PASSWORD=YOUR_SMTP_APP_PASSWORD
# Stripe Connect platform secret key, server only. Use a test key for development.

STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_PUBLISHABLE_KEY=YOUR_STRIPE_PUBLISHABLE_KEY
# Exact public client origin used for Stripe's return links; HTTPS in production.
PUBLIC_WEB_URL=http://localhost:3000
