[Unit]
Description=Dispatra independent application watchdog
After=network-online.target
Wants=network-online.target

[Service]
EnvironmentFile=/etc/dispatra/api.env
EnvironmentFile=/etc/dispatra/technical.env
ExecStart=/usr/bin/python3 /usr/local/libexec/dispatra-watchdog.py
Restart=always
RestartSec=10
MemoryMax=128M
TasksMax=32
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/dispatra-watchdog

[Install]
WantedBy=multi-user.target
